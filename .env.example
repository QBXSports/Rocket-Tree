# ==============================================================
# ZYVO QUICK-COMMERCE & LOCAL SERVICES — ENVIRONMENT CONFIGURATION
# ==============================================================

# Database Connection (SQLite local file by default, or PostgreSQL / Supabase)
DATABASE_URL="file:./dev.db"

# JWT Secret for Customer & Admin Session Tokens
JWT_SECRET="zyvo-production-secret-replace-with-random-hex-string"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================
# WHATSAPP ORDER NOTIFICATIONS (Store Admin: +91 8081529714)
# ==============================================================
# Default store owner recipient phone number (India format with country code)
WHATSAPP_RECIPIENT_PHONE="+918081529714"

# Provider Selection: "META_CLOUD_API" | "TWILIO" | "WEBHOOK"
WHATSAPP_PROVIDER="META_CLOUD_API"

# --- Option 1: Official Meta WhatsApp Cloud API (Recommended) ---
# 1. Register at https://developers.facebook.com/
# 2. Create a Business App and select WhatsApp
# 3. Obtain Phone Number ID and Permanent System User Access Token
WHATSAPP_CLOUD_API_TOKEN="EAABw..."
WHATSAPP_CLOUD_PHONE_NUMBER_ID="104829104812345"

# --- Option 2: Twilio WhatsApp API (Alternative) ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- Option 3: Custom Webhook Gateway (UltraMsg, Gupshup, etc.) ---
WHATSAPP_WEBHOOK_URL="https://api.ultramsg.com/instance.../messages/chat"

# ==============================================================
# SMS OTP GATEWAY (Optional - In test mode, OTP is logged to server console)
# ==============================================================
TWILIO_SMS_SID=""
FAST2SMS_API_KEY=""
MSG91_AUTH_KEY=""
